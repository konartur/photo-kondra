PORT=3000
APP_URL=http://localhost:3001
API_URL=http://localhost:3000
# Comma-separated browser origins. If unset, APP_URL is used. API_URL is also allowed for Swagger.
CORS_ALLOWED_ORIGINS=http://localhost:3001
# HTTP metadata only; originals and ZIP files go directly to object storage.
HTTP_BODY_LIMIT_BYTES=65536
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH=60
RATE_LIMIT_PUBLIC=600
RATE_LIMIT_ARCHIVE=10
RATE_LIMIT_API=1200
# Explicit trusted reverse-proxy IPs/CIDRs only. Empty means forwarded IPs are ignored.
TRUSTED_PROXY_CIDRS=
# At least 32 random bytes, identical on trusted ingress, Next.js and NestJS; required in production.
# Never use NEXT_PUBLIC_ for this variable. See README for ingress wiring.
BFF_TRUST_SECRET=

POSTGRES_USER=photo_cloud
POSTGRES_PASSWORD=photo_cloud
POSTGRES_DB=photo_cloud
POSTGRES_PORT=5432
DATABASE_URL=postgresql://photo_cloud:photo_cloud@localhost:5432/photo_cloud?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=1000
QUEUE_REMOVE_ON_COMPLETE_AGE=86400
QUEUE_REMOVE_ON_COMPLETE_COUNT=1000
QUEUE_REMOVE_ON_FAIL_AGE=604800
QUEUE_REMOVE_ON_FAIL_COUNT=5000

# Reserved for later milestones. Replace placeholder values before production.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional S3-compatible endpoint, for example MinIO or Cloudflare R2.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
SIGNED_URL_UPLOAD_TTL=900
# Maximum TTLs in seconds: upload/original 900; preview/archive 3600.
SIGNED_URL_PREVIEW_TTL=3600
SIGNED_URL_ORIGINAL_TTL=900
SIGNED_URL_ARCHIVE_TTL=3600
MAX_PHOTO_SIZE=26214400
MAX_ARCHIVE_SIZE=2147483648
IMAGE_THUMBNAIL_WIDTH=300
IMAGE_PREVIEW_WIDTH=1600
IMAGE_PROCESSING_LOCK_TTL=900
ARCHIVE_PROCESSING_LOCK_TTL=900
ARCHIVE_RETENTION_TTL=0
SELECTED_ARCHIVE_RETENTION_TTL=86400
SELECTED_ARCHIVE_MAX_ACTIVE=3
SELECTED_ARCHIVE_REQUESTS_PER_MINUTE=3

# Initial admin seed (required only by `npm run prisma:seed`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
