generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum GalleryStatus {
  DRAFT
  PROCESSING
  READY
  ARCHIVED
}

enum PhotoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum ArchiveStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  role         UserRole      @default(ADMIN)
  sessions     AuthSession[]
  galleries    Gallery[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AuthSession {
  id               String    @id
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Gallery {
  id          String          @id @default(uuid())
  title       String
  description String?
  status      GalleryStatus   @default(DRAFT)
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id])
  photos      Photo[]
  accessLinks GalleryAccess[]
  archives    Archive[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([ownerId])
  @@index([status])
}

model Photo {
  id                      String      @id @default(uuid())
  galleryId               String
  gallery                 Gallery     @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  originalKey             String?
  previewKey              String?
  thumbnailKey            String?
  filename                String
  mimeType                String
  size                    BigInt
  width                   Int?
  height                  Int?
  status                  PhotoStatus @default(UPLOADING)
  sortOrder               Int         @default(0)
  processingLockId        String?
  processingLockExpiresAt DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([galleryId])
  @@index([status])
  @@index([processingLockExpiresAt])
}

model GalleryAccess {
  id        String    @id @default(uuid())
  galleryId String
  gallery   Gallery   @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([galleryId])
  @@index([expiresAt])
}

model Archive {
  id                      String        @id @default(uuid())
  galleryId               String
  gallery                 Gallery       @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  storageKey              String?
  status                  ArchiveStatus @default(PENDING)
  processingLockId        String?
  processingLockExpiresAt DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  expiresAt               DateTime?

  @@index([galleryId])
  @@index([status])
  @@index([processingLockExpiresAt])
}
