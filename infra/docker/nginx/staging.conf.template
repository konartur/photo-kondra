# Staging ingress terminates TLS directly. Only the configured hostname is served.
error_log /dev/null;
ssl_protocols TLSv1.2 TLSv1.3;

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    access_log off;
    return 421;
}

server {
    listen 443 ssl;
    server_name ${STAGING_HOST};

    ssl_certificate /etc/nginx/staging-tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/staging-tls/privkey.pem;
    access_log off;
    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $server_name;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Photo-Ingress-Key "${BFF_TRUST_SECRET}";
        proxy_set_header X-Photo-Client-IP $remote_addr;
        proxy_set_header X-Photo-Client-Time "";
        proxy_set_header X-Photo-Client-Signature "";
    }
}
